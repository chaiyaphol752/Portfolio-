# Copy to .env.local for local development. Never commit real values.

# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: PostgreSQL connection string (Neon via Vercel Marketplace sets DATABASE_URL).
# When set, contact submissions are stored in the contact_submissions table.
DATABASE_URL=

# Optional: webhook that receives each contact submission as JSON
# (Slack/Discord-compatible incoming webhook, Formspree, Zapier, n8n ...).
CONTACT_WEBHOOK_URL=

# Optional: raises the GitHub API rate limit for the public-repo section.
GITHUB_TOKEN=
