# Copy to .env.local for local development. Never commit real values.

# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact delivery (at least one channel must be configured) ---

# Resend (email notification for every enquiry). Server-side only.
RESEND_API_KEY=
# Where enquiry notifications are delivered.
CONTACT_TO_EMAIL=chaiyaphol.752@gmail.com
# Sender on a domain verified in Resend, e.g. "Portfolio <contact@your-domain.com>".
# Leave empty to use Resend's test sender (onboarding@resend.dev), which can only
# deliver to the Resend account owner's own inbox and cannot send visitor confirmations.
CONTACT_FROM_EMAIL=
# Set to "false" to disable the acknowledgement email to visitors (needs a verified sender).
CONTACT_SEND_CONFIRMATION=

# Optional: PostgreSQL connection string (Neon via Vercel Marketplace sets DATABASE_URL).
DATABASE_URL=

# Optional: webhook that receives each submission as JSON (Slack/Discord-compatible).
CONTACT_WEBHOOK_URL=

# Optional: raises the GitHub API rate limit for the public-repo section.
GITHUB_TOKEN=
